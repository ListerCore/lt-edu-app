# Runtime of the Next.js server (mapped to NODE_ENV / HOSTNAME / PORT)
APP__NODE_ENV=development
APP__HOST=localhost
APP__PORT=5173

# Public origin of the site (Google sign-in redirects)
APP__SITE_URL=http://localhost:5173

# Institution whose public site this deployment serves (/news), by slug
APP__SITE__INSTITUTION=demo-ebr

# joseph-api base URL. Used by POST /complaints (Libro de Reclamaciones).
# Without it forms only work in development (logged to the console).
# APP__API__URL=http://localhost:5050

# joseph-api gRPC (host:port). Without it: host of APP__API__URL on port 9090. Plaintext on the internal network;
# set APP__API__GRPC_TLS=true if it sits behind TLS
# APP__API__GRPC_ADDR=localhost:5051
# APP__API__GRPC_TLS=false

# joseph-api gRPC (host:port). Without it: host of APP__API__URL on port 9090. Plaintext on the internal network;
# set APP__API__GRPC_TLS=true if it sits behind TLS
APP__API__GRPC_ADDR=localhost:5051
# APP__API__GRPC_TLS=false

# Cloudflare Turnstile site key (public) for the public forms. Inlined at build time: in Docker pass it with
# --build-arg NEXT_PUBLIC_TURNSTILE_SITE_KEY=... Without it development uses Cloudflare's always-pass test key.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
